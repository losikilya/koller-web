{
  "name": "portal-front-react",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@mona-health/react-input-mask": "3.0.3",
    "@reduxjs/toolkit": "2.13.0",
    "@types/jest": "^27.0.2",
    "@types/jquery": "^3.5.14",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axios": "^1.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.29.3",
    "env-cmd": "^10.1.0",
    "history": "4.10.1",
    "inputmask": "^5.0.8",
    "jaro-winkler": "^0.2.8",
    "jquery": "^3.6.0",
    "js-base64": "^3.7.7",
    "lodash.debounce": "^4.0.8",
    "react": "19.3.0",
    "react-currency-input-field": "3.9.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.52.2",
    "react-idle-timer": "^5.7.2",
    "react-redux": "9.3.0",
    "react-router": "7.18.4",
    "react-select": "5.9.0",
    "redux-persist": "^6.0.0",
    "sass": "1.77.6",
    "uuid-random": "^1.3.2",
    "yup": "^1.3.2"
  },
  "scripts": {
    "start": "env-cmd -e common,development vite",
    "start:dev": "set \"VITE_WITH_LOGGER=true\" && npm run start",
    "start:local": "set \"VITE_WITH_LOCAL_CONFIGS=true\" && npm run start",
    "build": "tsc -b && env-cmd -e common,production vite build",
    "build:release": "tsc -b && env-cmd -e common,production vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/version.json', JSON.stringify({version: Date.now()}))\"",
    "postbuild:release": "node -e \"require('fs').writeFileSync('dist/version.json', JSON.stringify({version: Date.now()}))\"",
    "preview": "env-cmd -e common,development vite preview",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "vitest run tests/bdd",
    "test:e2e:gen": "bddgen -c playwright.bdd.config.ts",
    "test:e2e": "npm run test:e2e:gen && playwright test -c playwright.bdd.config.ts",
    "test:unit": "vitest run tests --exclude tests/bdd/**",
    "test:workflow": "node --test scripts/workflow.test.mjs scripts/starter-config.test.mjs scripts/sync-claude.test.mjs scripts/sync-codex.test.mjs",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=ci-reports/junit/vitest.xml",
    "spec:init": "node scripts/openspec.mjs init --tools opencode --profile core --no-animation",
    "spec:validate": "node scripts/openspec.mjs validate --all --strict --no-interactive",
    "spec": "node scripts/openspec.mjs",
    "workflow": "node scripts/workflow.mjs",
    "tdd": "node scripts/tdd.mjs",
    "agents:sync": "node scripts/sync-claude.mjs && node scripts/sync-codex.mjs",
    "agents:check": "node scripts/sync-claude.mjs --check && node scripts/sync-codex.mjs --check",
    "verify": "npm run agents:check && npm run test:workflow && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e && npm run spec:validate",
    "verify:ci": "npm run agents:check && npm run test:workflow && npm run spec:validate && npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@fission-ai/openspec": "^1.11.0",
    "@hookform/devtools": "4.3.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/history": "4.7.11",
    "@types/inputmask": "^5.0.7",
    "@types/lodash.debounce": "^4.0.8",
    "@types/redux-logger": "^3.0.9",
    "@typescript-eslint/utils": "^8.71.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "7.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^13.2.0",
    "msw": "^2.15.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "2.8.4",
    "redux-logger": "^3.0.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "^4.1.11"
  },
  "browserslist": ["defaults"],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,scss,css,json}": "prettier --write"
  }
}
