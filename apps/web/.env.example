# Copy to apps/web/.env.local; paste the local CLI's public values only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_PUBLIC_KEY
# No secret/service-role key is required by the application.

# Trusted app origin for callback URLs and same-origin mutation checks.
AUTH_SITE_URL=http://127.0.0.1:3000

# Enable only after the Supabase Google provider has working credentials.
AUTH_GOOGLE_ENABLED=false
