{
  "name": "dance-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "pnpm dev",
    "start:dev": "pnpm dev",
    "start:local": "pnpm dev",
    "build": "turbo run build",
    "build:release": "pnpm build",
    "preview": "pnpm --filter @dance/web start --port 4310 --hostname 127.0.0.1",
    "typecheck": "turbo run typecheck && tsc --noEmit && tsc --noEmit -p .storybook/tsconfig.json",
    "lint": "turbo run lint && eslint tests --ext .ts,.tsx && pnpm boundaries && eslint .storybook packages/ui/stories --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "vitest run tests/bdd",
    "test:e2e:gen": "bddgen -c playwright.bdd.config.ts",
    "test:e2e": "pnpm test:e2e:gen && playwright test -c playwright.bdd.config.ts",
    "test:unit": "vitest run tests --exclude tests/bdd/**",
    "test:workflow": "node --test scripts/workflow.test.mjs scripts/starter-config.test.mjs scripts/sync-claude.test.mjs scripts/sync-codex.test.mjs scripts/architecture-refactor-workflow.test.mjs",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=ci-reports/junit/vitest.xml",
    "spec:init": "node scripts/openspec.mjs init --tools opencode --profile core --no-animation",
    "spec:validate": "node scripts/openspec.mjs validate --all --strict --no-interactive",
    "spec": "node scripts/openspec.mjs",
    "workflow": "node scripts/workflow.mjs",
    "tdd": "node scripts/tdd.mjs",
    "agents:sync": "node scripts/sync-claude.mjs && node scripts/sync-codex.mjs",
    "agents:check": "node scripts/sync-claude.mjs --check && node scripts/sync-codex.mjs --check",
    "verify": "pnpm agents:check && pnpm test:workflow && pnpm lint && pnpm typecheck && pnpm format && pnpm test && pnpm test:ci && pnpm build && pnpm storybook:build && pnpm test:e2e && pnpm test:storybook && pnpm spec:validate",
    "verify:ci": "pnpm verify",
    "dev": "turbo run dev",
    "boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --check apps packages tests openspec docs/web-platform/phase-1 docs/web-platform/phase-2 .storybook playwright.storybook.config.ts docs/adr/0002-dance-platform-foundation.md pnpm-workspace.yaml turbo.json tsconfig.json vitest.config.ts playwright.bdd.config.ts .github/workflows/verify.yml",
    "e2e": "pnpm test:e2e",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "test:storybook": "bddgen -c playwright.storybook.config.ts && playwright test -c playwright.storybook.config.ts"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@dance/design-tokens": "workspace:*",
    "@dance/ui": "workspace:*",
    "@fission-ai/openspec": "^1.11.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/utils": "^8.71.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.14.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "7.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "next": "16.4.3",
    "playwright-bdd": "^9.2.0",
    "prettier": "2.8.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.77.6",
    "storybook": "10.6.3",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
